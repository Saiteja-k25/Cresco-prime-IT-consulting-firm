---
// Footer after the blackbird.vc reference: a paper block with the call to action and the links, the logo in a
// circle on the seam, social buttons, the name set across the full width, and a bottom bar.
import Mark from './Mark.astro';

// From Kalyan's LinkedIn post ("For Recruitment & Enquiries"): swap it here if projects get their own inbox.
const email = 'hr@crescoprime.com';
const subject = encodeURIComponent('New project');
const arrow = 'M3.5 12H19M13.1 8l6.9 4-6.9 4';
const year = new Date().getFullYear();
const linkedinUrl = 'https://www.linkedin.com/company/cresco-prime/';
const instagramUrl = 'https://www.instagram.com/crescoprime/';
const whatsappUrl = 'https://wa.me/12484919357'; // +1 248 491 9357, opens a WhatsApp chat
// A phone handset (Feather icons, MIT), drawn inside the WhatsApp speech bubble.
const handset =
  'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z';
// LinkedIn's "in" glyph (Simple Icons, CC0).
const linkedin =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z';
---
<footer class="foot" id="contact" aria-labelledby="foot-title">
  <div class="foot__top">
    <div class="foot__cta">
      <h2 class="foot__title" id="foot-title">
        <span class="foot__light">Technology should</span> drive your business forward.
      </h2>
      <p class="foot__lede">Tell us what slows your team down.</p>
      <div class="foot__actions">
        <a class="cta" href={`mailto:${email}?subject=${subject}`}>
          <span class="cta__label" data-label="Start a project">Start a project</span>
          <span class="cta__chip" aria-hidden="true">
            <svg class="cta__arrow" viewBox="0 0 24 24"><path d={arrow} /></svg>
            <span class="cta__over"><svg class="cta__arrow" viewBox="0 0 24 24"><path d={arrow} /></svg></span>
          </span>
        </a>
      </div>
    </div>

    <nav class="foot__cols" aria-label="Footer">
      <div>
        <h3 class="foot__head">Company</h3>
        <ul role="list">
          <li><a href="/services/">Services</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/founder/">Founder</a></li>
        </ul>
      </div>
      <div>
        <h3 class="foot__head">Contact</h3>
        <ul role="list">
          <li><a href={`mailto:${email}`}>Email</a></li>
          <li><a href={linkedinUrl} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={instagramUrl} target="_blank" rel="noopener">Instagram</a></li>
          <li><a href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a></li>
        </ul>
      </div>
      <div>
        <h3 class="foot__head">Legal</h3>
        <ul role="list">
          <li><a href="/privacy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="foot__base">
    <!-- The logo on the seam. The flat mark is the fallback; the 3D mark turns slowly in the same stage. -->
    <div class="foot__emblem" aria-hidden="true">
      <div class="foot__stage" data-foot-mark>
        <Mark class="foot__flat" />
      </div>
    </div>

    <ul class="foot__social" role="list">
      <li>
        <a class="foot__icon" href={linkedinUrl} target="_blank" rel="noopener" aria-label="Cresco Prime on LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={linkedin} /></svg>
        </a>
      </li>
      <li>
        <a class="foot__icon" href={instagramUrl} target="_blank" rel="noopener" aria-label="Cresco Prime on Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="foot__stroke">
            <rect x="3.75" y="3.75" width="16.5" height="16.5" rx="4.75" /><circle cx="12" cy="12" r="3.9" /><circle class="foot__dot" cx="17.1" cy="6.9" r="0.9" />
          </svg>
        </a>
      </li>
      <li class="foot__reach">
        <a class="foot__icon" href={whatsappUrl} target="_blank" rel="noopener" aria-label="Message Cresco Prime on WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="foot__stroke" stroke-linejoin="round">
            <path d="M4.73 16.2A8.4 8.4 0 1 1 7.8 19.27L3.6 20.4z" />
            <g transform="translate(7.6 7.6) scale(0.36)" stroke-width="4.2"><path d={handset} /></g>
          </svg>
        </a>
      </li>
      <li>
        <a class="foot__icon" href={`mailto:${email}`} aria-label={`Email ${email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="foot__stroke"><path d="M3.5 6.5h17v11h-17zM3.5 7l8.5 6.5L20.5 7" /></svg>
        </a>
      </li>
    </ul>

    <p class="foot__word" aria-hidden="true">Cresco Prime</p>

    <div class="foot__bar">
      <p>&copy; {year} Cresco Prime</p>
      <p class="foot__legal"><a href="/privacy/">Privacy policy</a><a href="/terms/">Terms</a></p>
      <p>Frisco, Texas</p>
    </div>
    <p class="foot__credit">
      <a href="https://portfolio-ks-beta.vercel.app/" target="_blank" rel="noopener">Designed and crafted by Kurapati Saiteja</a>
    </p>
  </div>
</footer>

<script>
  // The 3D mark loads only as the footer comes near, and not for reduced motion or data saver.
  const stage = document.querySelector('[data-foot-mark]');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !navigator.connection?.saveData) {
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      import('../scripts/mark3d.js').then((m) => m.mount(stage, { turn: 1, light: 1, spin: 0.3 })).catch(() => {});
    }, { rootMargin: '400px 0px' });
    io.observe(stage);
  }
</script>

<style>
  .foot {
    --d: min(24vw, 21rem); /* the emblem's diameter */
    background: var(--ink);
    color: var(--ground);
  }

  /* Paper block: the call to action on the left, the link columns on the right, the emblem's half between. */
  .foot__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--d) minmax(0, 1fr);
    gap: 2rem;
    padding: clamp(5rem, 9vw, 8rem) var(--pad) calc(var(--d) * 0.5 + 1.5rem);
    border-top: 1px solid color-mix(in srgb, var(--ink) 16%, var(--ground)); /* parts it from a paper section above */
    background: var(--ground);
    color: var(--ink);
  }
  .foot__cta {
    grid-column: 1;
  }
  .foot__title {
    margin: 0 0 0 -0.035em;
    font-size: clamp(2.5rem, 4.4vw, 4.75rem);
    font-stretch: 78%;
    font-weight: 680;
    line-height: 0.88;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .foot__light {
    display: block;
    font-weight: 300;
  }
  .foot__lede {
    margin-top: 1.5rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
  }
  .foot__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 1.75rem;
  }

  .foot__cols {
    grid-column: 3;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    align-content: start;
  }
  .foot__head {
    margin: 0 0 0.75rem;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .foot__cols ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .foot__cols a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: inherit;
    font-size: 1rem;
    text-decoration: none;
  }
  .foot__cols a::after,
  .foot__legal a::after {
    content: '';
    position: absolute;
    inset: auto 0 0.35rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .foot__cols a:focus-visible::after,
  .foot__legal a:focus-visible::after {
    transform: scaleX(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .foot__cols a:hover::after,
    .foot__legal a:hover::after {
      transform: scaleX(1);
    }
  }

  /* Charcoal base. The emblem straddles the seam: paper on paper above, a paper disc on charcoal below. */
  .foot__base {
    position: relative;
    padding: 2.5rem var(--pad) 1.75rem;
    container-type: inline-size; /* the name below is sized from this box's width */
    overflow-x: clip; /* a fallback font may set the name wider for a moment: never let it widen the page */
  }
  .foot__emblem {
    position: absolute;
    top: calc(var(--d) * -0.5);
    left: 50%;
    width: var(--d);
    height: var(--d);
    margin-left: calc(var(--d) * -0.5);
    border-radius: 50%;
    background: var(--ground);
  }
  .foot__stage {
    --mark-fill: 0.64;
    position: absolute;
    inset: 0;
  }
  .foot__stage :global(.foot__flat),
  .foot__stage :global(canvas) {
    position: absolute;
    inset: 0;
    margin: auto;
  }
  .foot__stage :global(.foot__flat) {
    height: calc(var(--mark-fill) * 100%);
    width: auto;
    color: var(--ink);
    transition: opacity 0.6s;
  }
  .foot__stage :global(canvas) {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s;
  }
  .foot__stage:global(.is-3d) :global(.foot__flat) {
    opacity: 0;
  }
  .foot__stage:global(.is-3d) :global(canvas) {
    opacity: 1;
  }

  .foot__social {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .foot__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--ground);
    color: var(--ink);
    transition: background-color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .foot__icon svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: currentColor;
  }
  .foot__icon .foot__stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .foot__icon .foot__dot {
    fill: currentColor;
    stroke: none;
  }
  .foot__reach {
    margin-left: auto; /* profiles at the left edge, WhatsApp and email at the right: the middle belongs to the emblem */
  }
  .foot__icon:focus-visible {
    outline-color: var(--ground);
    background: var(--accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .foot__icon:hover {
      background: var(--accent);
      transform: translateY(-2px);
    }
  }

  .foot__word {
    margin: calc(var(--d) * 0.5 + 1rem) 0 0;
    /* The name fills the full width with no script: in this cut "CRESCO PRIME" is 8.14 times as wide as its font
       size, so 12.25% of the container's width fills 99.7% of it. vw is the fallback for browsers without cqi. */
    font-size: 10.6vw;
    font-size: 12.25cqi;
    font-stretch: 125%;
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .foot__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .foot__bar p {
    margin: 0;
  }
  .foot__bar p:last-child {
    text-align: right;
  }
  .foot__legal {
    display: flex;
    gap: 1.5rem;
  }
  .foot__legal a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
  }

  /* The designer's credit: one quiet line under the bar. */
  .foot__credit {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ground) 62%, var(--ink)); /* about 6:1 on the charcoal */
  }
  .foot__credit a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition: color 0.3s var(--ease-out), text-decoration-color 0.3s var(--ease-out);
  }
  .foot__credit a:focus-visible {
    color: var(--ground);
    text-decoration-color: currentColor;
  }
  @media (hover: hover) and (pointer: fine) {
    .foot__credit a:hover {
      color: var(--ground);
      text-decoration-color: currentColor;
    }
  }

  @media (max-width: 1100px) {
    .foot__top {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .foot__cta,
    .foot__cols {
      grid-column: 1;
    }
  }

  @media (max-width: 820px) {
    .foot {
      --d: min(34vw, 9rem);
    }
    .foot__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .foot__icon {
      width: 2.75rem;
      height: 2.75rem;
    }
    .foot__bar {
      grid-template-columns: 1fr auto;
    }
    .foot__legal {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 480px) {
    .foot__actions :global(.cta) {
      flex: 1 1 100%;
    }
  }
</style>
