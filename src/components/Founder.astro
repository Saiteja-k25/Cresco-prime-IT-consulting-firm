---
// The founder, as the second part of the About page. The message is the client's text (2026-11-19), with
// "Matrix Missions" corrected to Cresco Prime. The portrait stays in view beside it on desktop.
const arrow = 'M3.5 12H19M13.1 8l6.9 4-6.9 4';
---
<section class="founder" id="founder" aria-labelledby="founder-name">
  <div class="founder__inner">
    <div class="founder__text">
      <h2 class="founder__name" id="founder-name">Kalyan Boddula</h2>
      <p class="founder__role">Founder, Director and CEO</p>

      <h3 class="founder__title">
        <span class="founder__light">Driving Innovation.</span> Delivering Excellence.
      </h3>
      <div class="founder__message">
        <p>
          In an ever-evolving business landscape, innovation and strategic thinking are the foundations of sustainable
          growth and success.
        </p>
        <p>
          At Cresco Prime, we are driven by a passion for building intelligent business solutions, exploring new
          opportunities, and delivering excellence across every operation. We combine industry expertise, strategic
          thinking, and innovative approaches to help organizations overcome challenges and achieve their goals.
        </p>
        <p>
          Our focus goes beyond business growth. We believe in building meaningful partnerships, empowering talented
          professionals, and creating long-term value through continuous innovation, operational excellence, and a
          commitment to success.
        </p>
      </div>
      <blockquote class="founder__quote">
        <p>&ldquo;Turning Ambitions into Achievements. Transforming Vision into Reality.&rdquo;</p>
      </blockquote>

      <a class="link link--out" href="https://www.linkedin.com/in/kalyan-boddula-9abb43396/" target="_blank" rel="noopener">
        <span class="link__text">Kalyan on LinkedIn</span>
        <svg class="link__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} /></svg>
      </a>
    </div>
    <img
      class="founder__photo"
      src="/images/kalyan-boddula.webp"
      width="750"
      height="937"
      alt="Kalyan Boddula, founder of Cresco Prime"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style>
  .founder {
    padding: 0 var(--pad) clamp(5rem, 11vw, 10rem);
    background: var(--ground);
    color: var(--ink);
    scroll-margin-top: 6rem; /* the rule above the founder lands clear of the nav bar */
  }
  .founder__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(32vw, 30rem, 58svh);
    align-items: start;
    gap: clamp(2rem, 5vw, 5rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid color-mix(in srgb, var(--ink) 16%, var(--ground));
  }

  .founder__name {
    margin: 0 0 0 -0.035em;
    font-size: clamp(2.75rem, 6vw, 6.5rem);
    font-stretch: 78%;
    font-weight: 680;
    line-height: 0.88;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .founder__role {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  /* The message: a two-weight heading like the site's other titles, the text, then the line as a large quote. */
  .founder__title {
    margin: clamp(2.5rem, 5vw, 4rem) 0 1.5rem -0.03em;
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    font-stretch: 78%;
    font-weight: 680;
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .founder__light {
    display: block;
    font-weight: 300;
  }
  .founder__message p {
    max-width: 36rem;
    margin: 0 0 1.1rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
    line-height: 1.5;
  }
  .founder__quote {
    max-width: 30rem;
    margin: clamp(2rem, 4vw, 3rem) 0 clamp(1.75rem, 3vw, 2.5rem);
  }
  .founder__quote p {
    margin: 0;
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .founder__photo {
    position: sticky;
    top: 7rem;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: color-mix(in srgb, var(--ink) 10%, var(--ground)); /* holds the space while the photo loads */
  }

  @media (max-width: 820px) {
    .founder__inner {
      grid-template-columns: 1fr;
    }
    .founder__photo {
      position: static;
      order: -1; /* the face first on a phone */
      max-width: 26rem;
    }
  }
</style>
