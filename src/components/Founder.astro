---
// The founder, on a page of his own. Copy is a draft from Kalyan's LinkedIn page, for the client to approve.
const arrow = 'M3.5 12H19M13.1 8l6.9 4-6.9 4';
---
<section class="founder" id="founder" aria-labelledby="founder-name">
  <div class="founder__text">
    <h2 class="founder__name" id="founder-name">Kalyan Boddula</h2>
    <p class="founder__role">Founder, Director and CEO</p>
    <p class="founder__bio">
      Kalyan started Cresco Prime in 2026. His own field is Microsoft Azure and identity and access management:
      single sign-on, multi-factor authentication and the systems that decide who in a company can reach what.
      He also leads Matrix Missions and Convex Funding.
    </p>
    <a class="link link--out" href="https://www.linkedin.com/in/kalyan-boddula-9abb43396/" target="_blank" rel="noopener">
      <span class="link__text">Kalyan on LinkedIn</span>
      <svg class="link__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} /></svg>
    </a>
  </div>
  <img
    class="founder__photo"
    src="/images/kalyan-boddula.webp"
    width="750"
    height="937"
    alt="Kalyan Boddula, founder of Cresco Prime"
    fetchpriority="high"
    decoding="async"
  />
</section>

<style>
  .founder {
    display: grid;
    /* The portrait is sized so it and the bio fit one screen together. */
    grid-template-columns: minmax(0, 1fr) min(32vw, 30rem, 58svh);
    align-items: end;
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(1rem, 3vw, 2.5rem) var(--pad) clamp(5rem, 11vw, 10rem); /* the page head sits right above */
    background: var(--ground);
    color: var(--ink);
  }

  .founder__name {
    margin: 0 0 0 -0.035em;
    font-size: clamp(2.75rem, 6vw, 6.5rem);
    font-stretch: 78%;
    font-weight: 680;
    line-height: 0.88;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .founder__role {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .founder__bio {
    max-width: 34rem;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 1.25rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
    line-height: 1.45;
  }

  .founder__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: color-mix(in srgb, var(--ink) 10%, var(--ground)); /* holds the space while the photo loads */
  }

  @media (max-width: 820px) {
    .founder {
      grid-template-columns: 1fr;
    }
    .founder__photo {
      order: -1; /* the face first on a phone */
      max-width: 26rem;
    }
  }
</style>
