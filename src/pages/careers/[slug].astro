---
// One page per open role (Google for Jobs lists a role only from a page of its own).
// Apply opens a form in a panel; it posts to the Cloudflare function in functions/api/apply.js, which emails the
// application to hr@ and a confirmation to the applicant. Without JavaScript, Apply is a plain email link.
import Base from '../../layouts/Base.astro';
import { jobs, posted, remote, typeLabel } from '../../lib/jobs.js';
import { crumbs, jobPosting } from '../../lib/site.js';

export function getStaticPaths() {
  return jobs.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}

const { job } = Astro.props;
const email = 'hr@crescoprime.com';
const mailto = `mailto:${email}?subject=${encodeURIComponent(`Application: ${job.title}`)}`;
// Cloudflare Turnstile. The fallback is Cloudflare's public test key, which always passes: production sets the real
// key as PUBLIC_TURNSTILE_SITE_KEY in the Pages build settings (see README).
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
const arrow = 'M3.5 12H19M13.1 8l6.9 4-6.9 4';
const facts = [
  ['Department', job.department],
  ['Experience', job.experience],
  ['Employment', typeLabel[job.type]],
  ['Location', remote.label],
];
const schema = [crumbs(['Careers', '/careers/'], [job.title, `/careers/${job.slug}/`]), jobPosting(job, posted, remote)];
const sections = [
  ['Key responsibilities', job.responsibilities],
  ['Required skills', job.skills],
  ['Preferred qualifications', job.preferred],
].filter(([, items]) => items?.length);
---
<Base
  title={`${job.title} | Careers | Cresco Prime`}
  description={`${job.title} at Cresco Prime: remote, ${job.experience} of experience, ${job.department}. Read the role and apply.`}
  schema={schema}
>
  <article class="role">
    <header class="role__head">
      <a class="link link--back" href="/careers/">
        <svg class="link__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} /></svg>
        <span class="link__text">All open roles</span>
      </a>
      <h1 class="role__title">{job.title}</h1>
    </header>

    <div class="role__body">
      <aside class="role__aside" aria-label="About this role">
        <dl class="role__facts">
          {facts.map(([label, value]) => (
            <div>
              <dt class="mono">{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        <a class="cta" href={mailto} data-apply aria-haspopup="dialog">
          <span class="cta__label" data-label="Apply for this role">Apply for this role</span>
          <span class="cta__chip" aria-hidden="true">
            <svg class="cta__arrow" viewBox="0 0 24 24"><path d={arrow} /></svg>
            <span class="cta__over"><svg class="cta__arrow" viewBox="0 0 24 24"><path d={arrow} /></svg></span>
          </span>
        </a>
        <p class="role__note">A short form and your CV. It takes about five minutes.</p>
      </aside>

      <div class="role__text">
        <h2>Job overview</h2>
        <p>{job.overview}</p>
        {sections.map(([heading, items]) => (
          <>
            <h2>{heading}</h2>
            <ul>
              {items.map((item) => <li>{item}</li>)}
            </ul>
          </>
        ))}
      </div>
    </div>
  </article>

  <!-- The application form. The panel scrolls on its own; the page behind stays still. -->
  <dialog class="apply" id="apply" aria-labelledby="apply-title" data-sitekey={sitekey} data-mailto={mailto}>
    <div class="apply__panel" data-lenis-prevent>
      <header class="apply__head">
        <div>
          <p class="mono">Apply for</p>
          <h2 class="apply__title" id="apply-title">{job.title}</h2>
        </div>
        <button class="apply__close" type="button" data-close aria-label="Close the application form">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </header>

      <form class="apply__form" method="post" action="/api/apply" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="role" value={job.slug} />
        <!-- A field people never see: bots fill it in, and the server quietly drops those submissions. -->
        <div class="apply__trap" aria-hidden="true">
          <label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="apply__grid">
          <div class="field field--wide">
            <label for="f-name">Full name</label>
            <input id="f-name" name="name" required maxlength="120" autocomplete="name" />
            <p class="field__error" id="f-name-error"></p>
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" required maxlength="200" autocomplete="email" />
            <p class="field__error" id="f-email-error"></p>
          </div>
          <div class="field">
            <label for="f-phone">Phone, with country code</label>
            <input id="f-phone" name="phone" type="tel" required maxlength="40" autocomplete="tel" placeholder="+1 555 010 0100" />
            <p class="field__error" id="f-phone-error"></p>
          </div>
          <div class="field field--wide">
            <label for="f-location">Where are you based?</label>
            <input id="f-location" name="location" required maxlength="120" autocomplete="off" placeholder="City, country" />
            <p class="field__error" id="f-location-error"></p>
          </div>
          <div class="field">
            <label for="f-total">Total years of experience</label>
            <input id="f-total" name="experience_total" type="number" required min="0" max="60" step="1" inputmode="numeric" />
            <p class="field__error" id="f-total-error"></p>
          </div>
          <div class="field">
            <label for="f-core">Years with {job.core}</label>
            <input id="f-core" name="experience_core" type="number" required min="0" max="60" step="1" inputmode="numeric" />
            <p class="field__error" id="f-core-error"></p>
          </div>
          <div class="field field--wide">
            <label for="f-current">Current or most recent job title and company <span>(optional)</span></label>
            <input id="f-current" name="current_role" maxlength="160" autocomplete="organization-title" />
            <p class="field__error" id="f-current-error"></p>
          </div>
          <div class="field">
            <label for="f-notice">Notice period or earliest start date</label>
            <input id="f-notice" name="notice" required maxlength="120" placeholder="For example, 2 weeks" />
            <p class="field__error" id="f-notice-error"></p>
          </div>
          <div class="field">
            <label for="f-pay">Expected compensation <span>(optional)</span></label>
            <input id="f-pay" name="compensation" maxlength="120" placeholder="For example, USD 60 an hour" />
            <p class="field__error" id="f-pay-error"></p>
          </div>
          <div class="field field--wide">
            <label for="f-linkedin">LinkedIn profile <span>(optional)</span></label>
            <input id="f-linkedin" name="linkedin" type="url" maxlength="300" placeholder="https://www.linkedin.com/in/…" />
            <p class="field__error" id="f-linkedin-error"></p>
          </div>
          <div class="field field--wide">
            <label for="f-cv">CV <span>(PDF or Word, up to 3 MB)</span></label>
            <input id="f-cv" name="cv" type="file" required accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            <p class="field__error" id="f-cv-error"></p>
          </div>
          <div class="field field--wide">
            <label for="f-note">Anything else we should know? <span>(optional)</span></label>
            <textarea id="f-note" name="note" rows="4" maxlength="1500"></textarea>
            <p class="field__error" id="f-note-error"></p>
          </div>
          <div class="field field--wide field--check">
            <input id="f-consent" name="consent" type="checkbox" value="yes" required />
            <label for="f-consent">
              I agree to Cresco Prime handling my application as described in the <a href="/privacy/" target="_blank" rel="noopener">privacy policy</a>.
            </label>
            <p class="field__error" id="f-consent-error"></p>
          </div>
        </div>

        <div class="apply__check" data-turnstile></div>
        <p class="apply__status" role="status" aria-live="polite"></p>

        <button class="cta apply__send" type="submit">
          <span class="cta__label" data-label="Submit application">Submit application</span>
          <span class="cta__chip" aria-hidden="true">
            <svg class="cta__arrow" viewBox="0 0 24 24"><path d={arrow} /></svg>
            <span class="cta__over"><svg class="cta__arrow" viewBox="0 0 24 24"><path d={arrow} /></svg></span>
          </span>
        </button>
      </form>

      <div class="apply__done" hidden tabindex="-1">
        <h3 class="apply__done-title">Application sent.</h3>
        <p>
          Thank you, <span data-out="name"></span>. Your application for {job.title} has reached our team, and a
          confirmation is on its way to <span data-out="email"></span>.
        </p>
        <button class="link" type="button" data-close><span class="link__text">Close</span></button>
      </div>
    </div>
  </dialog>
</Base>

<script>
  import { lenis } from '../../scripts/scroll.js';

  const dialog = document.querySelector('#apply');
  const form = dialog.querySelector('form');
  const status = dialog.querySelector('.apply__status');
  const done = dialog.querySelector('.apply__done');
  const sendButton = dialog.querySelector('.apply__send');
  const holder = dialog.querySelector('[data-turnstile]');
  const MAX_CV = 3 * 1000 * 1000;
  let widget = null;
  let pending = null; // the spam check of the current Submit

  // Runs Cloudflare's check now and resolves with a fresh token (rejects with Cloudflare's error code).
  const humanCheck = () =>
    new Promise((resolve, reject) => {
      const timer = setTimeout(() => reject('slow'), 120000); // room to notice and tick the box
      pending = {
        resolve: (t) => (clearTimeout(timer), resolve(t)),
        reject: (c) => (clearTimeout(timer), reject(c)),
      };
      window.turnstile.reset(widget);
      window.turnstile.execute(widget);
    }).finally(() => (pending = null));

  // Cloudflare's bot check loads only when someone opens the form.
  const turnstileReady = () =>
    window.turnstile
      ? Promise.resolve()
      : new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
          s.async = true;
          s.onload = resolve;
          s.onerror = reject;
          document.head.append(s);
        });

  let ready = null; // settles once the widget is on the page; Submit waits for it
  const open = () => {
    dialog.showModal();
    lenis?.stop();
    ready ??= load();
  };
  const load = async () => {
    try {
      await turnstileReady();
      // The check runs on Submit, not on open: a token made on open can expire or stall while someone types on a
      // phone or leaves the page for the file picker. The box shows only if Cloudflare wants a tick.
      widget ??= window.turnstile.render(holder, {
        sitekey: dialog.dataset.sitekey,
        theme: 'light',
        size: 'flexible',
        execution: 'execute',
        appearance: 'interaction-only',
        retry: 'never',
        callback: (token) => pending?.resolve(token),
        'error-callback': (code) => (pending?.reject(code), true),
        'timeout-callback': () => pending?.reject('timeout'),
        'before-interactive-callback': () => {
          say('Please tick “Verify you are human” above to send your application.');
          holder.scrollIntoView({ block: 'center', behavior: 'smooth' });
        },
      });
    } catch {
      ready = null; // try again on the next open or Submit
      say(`The spam check could not load. You can also email your CV to hr@crescoprime.com.`);
    }
  };

  document.querySelectorAll('[data-apply]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      open();
    }),
  );
  dialog.addEventListener('close', () => {
    lenis?.start();
    if (!done.hidden) {
      done.hidden = true; // next time the form opens fresh
      form.hidden = false;
      say('');
    }
  });
  dialog.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close()); // a click on the backdrop

  function say(text, link) {
    status.textContent = text;
    if (link) {
      const a = Object.assign(document.createElement('a'), { href: dialog.dataset.mailto, textContent: link });
      status.append(' ', a, '.');
    }
  }

  // Errors sit under their field and are announced with it.
  function mark(name, message) {
    const input = form.elements[name];
    const error = input?.id && form.querySelector(`#${input.id}-error`);
    if (!error) return; // fields without a message slot (the role, the bot check) are never marked
    input.toggleAttribute('aria-invalid', !!message);
    if (message) input.setAttribute('aria-describedby', error.id);
    else input.removeAttribute('aria-describedby');
    error.textContent = message || '';
  }

  function check() {
    const errors = {};
    const value = (n) => form.elements[n].value.trim();
    for (const n of ['name', 'phone', 'location', 'notice']) if (!value(n)) errors[n] = 'Please fill this in.';
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value('email'))) errors.email = 'Please enter a valid email address.';
    for (const n of ['experience_total', 'experience_core']) {
      const v = value(n);
      if (v === '' || !(Number(v) >= 0 && Number(v) <= 60)) errors[n] = 'Please enter a number of years, 0 to 60.';
    }
    const li = value('linkedin');
    if (li && !/^https:\/\/\S+$/.test(li)) errors.linkedin = 'Please paste the full link, starting with https://';
    const cv = form.elements.cv.files[0];
    if (!cv) errors.cv = 'Please attach your CV.';
    // Some phone file pickers drop the extension; the server then checks the file's contents instead.
    else if (/\.[a-z0-9]{1,5}$/i.test(cv.name) && !/\.(pdf|docx?)$/i.test(cv.name)) errors.cv = 'Please attach a PDF or Word file.';
    else if (cv.size > MAX_CV) errors.cv = 'This file is over 3 MB. Please attach a smaller version.';
    if (!form.elements.consent.checked) errors.consent = 'Please tick this box to send your application.';
    return errors;
  }

  // On a phone the field with the problem is often far above the button: bring it into view, then focus it.
  function show(name) {
    const input = form.elements[name];
    input?.closest('.field')?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    input?.focus({ preventScroll: true });
  }

  // A field's message clears as soon as it is corrected.
  const clear = (e) => {
    if (!e.target.hasAttribute?.('aria-invalid')) return;
    mark(e.target.name, '');
    if (!form.querySelector('[aria-invalid]')) say('');
  };
  form.addEventListener('input', clear);
  form.addEventListener('change', clear);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    say('');
    const errors = check();
    for (const el of form.elements) if (el.name && el.id) mark(el.name, errors[el.name]);
    const first = Object.keys(errors)[0];
    if (first) {
      show(first);
      say('Please check the highlighted fields.');
      return;
    }
    sendButton.disabled = true;
    say('Checking the form…');
    await (ready ??= load()); // the spam check may still be loading on a slow phone
    if (widget === null) {
      sendButton.disabled = false;
      say('The spam check could not load. Please reload the page, or', 'email your CV to hr@crescoprime.com');
      return;
    }
    let token;
    try {
      token = await humanCheck();
    } catch (code) {
      sendButton.disabled = false;
      say(`The spam check did not finish (${code}). Please send again, or`, 'email your CV to hr@crescoprime.com');
      return;
    }
    say('Sending your application…');
    try {
      const body = new FormData(form);
      body.set('cf-turnstile-response', token);
      const response = await fetch(form.action, { method: 'POST', body });
      const result = await response.json().catch(() => ({}));
      if (response.ok && result.ok) {
        done.querySelector('[data-out="name"]').textContent = form.elements.name.value.trim().split(/\s+/)[0];
        done.querySelector('[data-out="email"]').textContent = form.elements.email.value.trim();
        form.hidden = true;
        done.hidden = false;
        done.focus();
        form.reset();
        return;
      }
      if (result.errors) {
        for (const [n, m] of Object.entries(result.errors)) mark(n, m);
        show(Object.keys(result.errors)[0]);
      }
      say(result.message || 'Something went wrong. Please try again, or', result.message ? null : 'email your CV to hr@crescoprime.com');
    } catch {
      say('Your application could not be sent. Please check your connection and try again, or', 'email your CV to hr@crescoprime.com');
    } finally {
      sendButton.disabled = false;
    }
  });
</script>

<style>
  .role {
    --rule: color-mix(in srgb, var(--ink) 16%, var(--ground));
    padding: calc(var(--pad) + 8rem) var(--pad) clamp(5rem, 11vw, 10rem);
    background: var(--ground);
    color: var(--ink);
  }

  .role__head {
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .role .link--back .link__arrow {
    rotate: 180deg; /* points back to the list */
    transform: translateX(calc(var(--on) * -4px));
  }
  .role__title {
    max-width: 18ch;
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0 -0.035em;
    font-size: clamp(2.75rem, 7vw, 7.5rem);
    font-stretch: 78%;
    font-weight: 680;
    line-height: 0.88;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* The facts and Apply stay in view on the right while the text scrolls. */
  .role__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    gap: 2.5rem clamp(2.5rem, 7vw, 7rem);
    align-items: start;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--rule);
  }
  .role__aside {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .role__facts {
    display: grid;
    gap: 1.1rem;
    margin: 0;
  }
  .role__facts dt {
    color: var(--muted);
  }
  .role__facts dd {
    margin: 0.3rem 0 0;
    font-size: 1.0625rem;
    font-weight: 500;
  }
  .role__note {
    margin: -0.75rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .role__text {
    grid-column: 1;
    grid-row: 1;
    max-width: 44rem;
    font-size: clamp(1.0625rem, 1.2vw, 1.1875rem);
    line-height: 1.6;
  }
  .role__text h2 {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .role__text h2:first-child {
    margin-top: 0;
  }
  .role__text p {
    margin: 0;
  }
  .role__text ul {
    margin: 0;
    padding-left: 1.25rem;
  }
  .role__text li {
    margin-bottom: 0.45rem;
    padding-left: 0.25rem;
  }

  /* The application panel: slides in from the right edge, full screen on phones. */
  .apply {
    --rule: color-mix(in srgb, var(--ink) 22%, var(--ground));
    width: min(44rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--ground);
    color: var(--ink);
    box-shadow: -24px 0 64px rgb(0 0 0 / 0.18);
  }
  .apply[open] {
    animation: apply-in 0.55s var(--ease-out);
  }
  @keyframes apply-in {
    from {
      transform: translateX(100%);
    }
  }
  .apply::backdrop {
    background: rgb(36 36 36 / 0.55);
  }
  .apply__panel {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .apply__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }
  .apply__head .mono {
    margin: 0 0 0.5rem;
    color: var(--muted);
  }
  .apply__title {
    margin: 0 0 0 -0.03em;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    font-stretch: 78%;
    font-weight: 680;
    line-height: 0.9;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .apply__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--ground);
    cursor: pointer;
    transition: transform 0.2s var(--ease-out);
  }
  .apply__close svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
  }
  .apply__close:active {
    transform: scale(0.94);
  }

  .apply__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .field--wide {
    grid-column: 1 / -1;
  }
  .field label {
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .field label span {
    color: var(--muted);
    font-weight: 400;
  }
  .field input:not([type='checkbox']),
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    background: color-mix(in srgb, white 55%, var(--ground));
    color: inherit;
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  .field textarea {
    resize: vertical;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: color-mix(in srgb, var(--ink) 45%, var(--ground));
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px var(--accent);
  }
  .field input[aria-invalid],
  .field textarea[aria-invalid] {
    border-color: #b42318;
  }
  .field input[type='file'] {
    padding: 0.5rem;
  }
  .field input[type='file']::file-selector-button {
    margin-right: 0.9rem;
    padding: 0.55rem 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ground);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  .field--check {
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: 0.75rem;
  }
  .field--check input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.15rem 0 0;
    accent-color: var(--ink);
  }
  .field--check label {
    font-weight: 400;
    line-height: 1.45;
  }
