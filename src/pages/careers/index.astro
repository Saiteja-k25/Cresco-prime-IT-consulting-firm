---
// The open roles, one row each, every row leading to the role's own page.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { jobs } from '../../lib/jobs.js';
import { SITE, crumbs } from '../../lib/site.js';

const arrow = 'M3.5 12H19M13.1 8l6.9 4-6.9 4';
const list = {
  '@type': 'ItemList',
  name: 'Open roles at Cresco Prime',
  itemListElement: jobs.map((j, i) => ({ '@type': 'ListItem', position: i + 1, name: j.title, url: `${SITE}/careers/${j.slug}/` })),
};
---
<Base
  title="Careers | Cresco Prime"
  description="Open roles at Cresco Prime in identity and access management, cybersecurity, Salesforce, SAP, Workday and networking."
  schema={[list, crumbs(['Careers', '/careers/'])]}
>
  <PageHead title="Careers" lede="The roles we are hiring for now. Open one to read it in full and apply." tone="ink" />

  <section class="jobs" aria-label="Open roles">
    <ul class="jobs__list" role="list">
      {jobs.map((j) => (
        <li>
          <a class="jobs__row" href={`/careers/${j.slug}/`}>
            <h2 class="jobs__title">
              <span>{j.title}</span>
              <svg class="jobs__light" viewBox="0 0 100 104" aria-hidden="true">
                <polygon points="50,0 100,28.9 100,75.1 50,104 0,75.1 0,28.9" />
              </svg>
            </h2>
            <span class="jobs__meta mono">
              <span>{j.department}</span>
              <span>{j.experience}</span>
            </span>
            <svg class="jobs__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .jobs {
    --rule: color-mix(in srgb, var(--ground) 18%, var(--ink));
    --soft: color-mix(in srgb, var(--ground) 64%, var(--ink)); /* about 6:1 on the charcoal */
    padding: 0 var(--pad) clamp(5rem, 11vw, 10rem);
    background: var(--ink);
    color: var(--ground);
  }
  .jobs__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  /* Each role: its title in the display cut, department and experience beside it, an arrow at the end. */
  .jobs__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem) auto;
    align-items: center;
    gap: 0.75rem clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(1.25rem, 2.6vw, 2.25rem) 0;
    border-top: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }
  .jobs__title {
    display: flex;
    align-items: flex-start;
    gap: 0.14em;
    margin: 0 0 0 -0.03em;
    font-size: clamp(1.75rem, 3.8vw, 3.75rem);
    font-stretch: 78%;
    font-weight: 680;
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  /* The light switches on for the role under the pointer, as it does for the service groups. */
  .jobs__light {
    flex: none;
    width: 0.26em;
    height: 0.27em;
    margin-top: 0.06em;
    fill: var(--accent);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.3s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .jobs__meta {
    display: grid;
    gap: 0.25rem;
    color: var(--soft);
  }
  .jobs__arrow {
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
    transition: transform 0.3s var(--ease-out);
  }
  .jobs__row:focus-visible {
    outline-offset: 4px;
  }
  .jobs__row:focus-visible .jobs__light {
    opacity: 1;
    transform: scale(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .jobs__row:hover .jobs__light {
      opacity: 1;
      transform: scale(1);
    }
    .jobs__row:hover .jobs__arrow {
      transform: translateX(4px);
    }
  }

  @media (max-width: 820px) {
    .jobs__row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .jobs__meta {
      grid-column: 1;
      grid-row: 2;
    }
    .jobs__arrow {
      grid-row: 1 / span 2;
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jobs__light {
      transform: none;
    }
  }
</style>
