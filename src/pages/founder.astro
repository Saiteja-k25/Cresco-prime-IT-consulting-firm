---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Founder from '../components/Founder.astro';
import { SITE, PERSON_ID, person, crumbs } from '../lib/site.js';

const page = { '@type': 'ProfilePage', url: `${SITE}/founder/`, name: 'Kalyan Boddula, Founder of Cresco Prime', mainEntity: { '@id': PERSON_ID } };
---
<Base
  title="Kalyan Boddula, Founder | Cresco Prime"
  description="Kalyan Boddula is the founder, director and CEO of Cresco Prime, an IT services and consulting firm in Frisco, Texas."
  schema={[person, page, crumbs('Founder', '/founder/')]}
>
  <PageHead title="Founder" lede="The person who started Cresco Prime in 2026." />
  <Founder />
</Base>
